# Supabase (new API key system: publishable/secret keys + JWKS-verified JWTs)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Direct Postgres connection, used only for running migrations/seeders
# locally (psql) — not read by the app itself. Dashboard -> Project
# Settings -> Database -> Connection string -> URI ("Direct connection",
# not the pooler). Format:
# postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_DB_URL=

# LiteLLM gateway — self-hosted separately (currently: STB box via
# Cloudflare tunnel, https://llm.<domain>, NOT part of this repo's
# docker-compose — see litellm/config.yaml + deploy notes). The VPS-side
# app only needs the base URL + the shared master key; the provider keys
# below live in the gateway's own .env, not here — only needed here for
# local dev if you're also running a local litellm proxy against this repo.
LITELLM_BASE_URL=https://llm.example.com
LITELLM_API_KEY=
OPENROUTER_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=

# Deploy
DOMAIN=
API_BASE_URL=https://api.example.com
CORS_ORIGINS=https://example.com
